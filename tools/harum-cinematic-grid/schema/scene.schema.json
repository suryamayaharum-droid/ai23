{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Harum Cinematic Scene",
  "type":"object",
  "required":["shots"],
  "properties":{
    "project":{"type":"string"},
    "scene":{"type":"string"},
    "render":{"type":"string"},
    "output":{"type":"object"},
    "audio":{"type":"object"},
    "shots":{"type":"array","minItems":1,"items":{
      "type":"object","required":["id","duration"],
      "properties":{
        "id":{"type":"string"},"duration":{"type":"number","exclusiveMinimum":0},
        "type":{"enum":["image","video"]},"src":{"type":"string"},
        "input_asset":{"type":["string","null"]},"output":{"type":["string","null"]},
        "engine":{"type":["string","null"]},"task":{"type":["string","null"]},
        "prompt":{"type":["string","null"]},"gate":{"type":"array","items":{"type":"string"}}
      }
    }}
  }
}
