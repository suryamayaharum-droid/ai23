{
  "version": "14.1",
  "core": [
    "bundle_protocol_pattern",
    "sneakernet_capsules",
    "mergeable_state"
  ],
  "high_priority_optional": [
    "willow",
    "reticulum",
    "earthstar_v11",
    "libp2p"
  ],
  "optional": [
    "yggdrasil",
    "syncthing",
    "ipfs",
    "iroh",
    "freenet",
    "named_data_networking",
    "raptorq"
  ],
  "principles": [
    "zero-paid-core",
    "no-single-provider",
    "offline-capable",
    "intermittent-connectivity",
    "transport-agnostic",
